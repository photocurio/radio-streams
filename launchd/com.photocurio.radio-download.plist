<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs radio-download.js every day at 9:00 AM (or when the Mac next wakes).
  Episodes already saved are skipped, so a daily run just picks up whatever
  is new for every show in shows.json.

  Install:   cp launchd/com.photocurio.radio-download.plist ~/Library/LaunchAgents/
             launchctl load ~/Library/LaunchAgents/com.photocurio.radio-download.plist
  Run now:   launchctl start com.photocurio.radio-download
  Log:       ~/Library/Logs/radio-download.log
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.photocurio.radio-download</string>

	<!-- Loads nvm so the job uses your default Node version, whichever that is. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>source "$HOME/.nvm/nvm.sh" &amp;&amp; node "$HOME/Projects/radio-streams/radio-download.js"</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key><integer>9</integer>
		<key>Minute</key><integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/petermumford/Library/Logs/radio-download.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/petermumford/Library/Logs/radio-download.log</string>
</dict>
</plist>
